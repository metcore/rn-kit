<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- API 31+: the platform SplashScreen supersedes windowBackground, so
         brand the system splash directly. -->
    <style name="SplashTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/logo_splash</item>
        <item name="android:windowBackground">@drawable/launch_screen</item>
    </style>

</resources>
